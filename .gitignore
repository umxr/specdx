node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo

# Development artifacts (kept locally, not in repo)
CLAUDE.md
roadmap.md
spec.config.yaml
specs/
docs/superpowers/

# The GitHub Action is bundled and committed: GitHub runs it straight from a
# checkout, with no install step, so the built entrypoint must live in the ref.
!packages/github-action/bundle/

# The action fixture must reach a runner, so it is exempt from the repo-wide
# spec.config.yaml / specs/ ignores that keep this project's own specs local.
!packages/github-action/test/fixture-project/spec.config.yaml
!packages/github-action/test/fixture-project/specs/
!packages/github-action/test/fixture-project/specs/**

# The empty fixture is the point: its paths resolve to no files, so the smoke
# workflow can prove the action fails a vacuous suite rather than passing it
# (audit run 5, F1). Being ignored is how it stayed untested — a checkout that
# honours .gitignore simply dropped it.
!packages/github-action/test/empty-project/spec.config.yaml

# Copied from the repo root at build time so the published package carries them.
packages/cli/README.md
packages/cli/LICENSE
