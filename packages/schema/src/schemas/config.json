{
  "$id": "sdx-config",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "specs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string", "enum": ["prd", "technical-design", "user-story", "test-plan", "adr", "api-contract"] },
          "required": { "type": "boolean", "default": false },
          "requires": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" }
        },
        "required": ["path", "type"],
        "additionalProperties": false
      }
    },
    "lint": {
      "type": "object",
      "properties": {
        "extends": { "type": "string" },
        "rules": { "type": "object" },
        "ignore": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "pack": {
      "type": "object",
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "enum": ["xml", "markdown", "json"] },
        "compression": {
          "type": "object",
          "properties": {
            "strip_boilerplate": { "type": "boolean" },
            "stable_days": { "type": "integer", "minimum": 0 },
            "collapse_resolved_adrs": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "boilerplate_sections": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "properties": {
        "baseline_ref": { "type": "string", "default": "main" },
        "staleness_threshold_days": { "type": "integer", "minimum": 1, "default": 14 },
        "ignore_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "block_on": {
          "type": "array",
          "items": { "type": "string", "enum": ["error", "warn", "info"] }
        },
        "post_comment": { "type": "boolean", "default": true },
        "update_badge": { "type": "boolean", "default": true },
        "trigger_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["auto", "express", "hono", "nextjs"]
        },
        "routes_dir": { "type": "string" },
        "app_dir": { "type": "string" },
        "types_dir": { "type": "string" },
        "tests_dir": { "type": "string" },
        "ignore": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["version", "specs"],
  "additionalProperties": false
}
