#!/usr/bin/env bash
# SessionStart hook for specdx plugin
# Detects if the current project uses specdx and injects a lightweight summary.

set -euo pipefail

# Search upward from $PWD for spec.config.yaml
find_config() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/spec.config.yaml" ]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

PROJECT_ROOT="$(find_config 2>/dev/null)" || exit 0

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Determine the specdx invocation.
#
# Order matters. Resolving `specdx` from PATH first meant the plugin ran
# whatever version happened to be installed globally -- a stale one reported
# the project's config as invalid, and that answer was injected into the
# session as fact. A plugin ships with its own CLI; it must run that one.
#
#   1. the CLI bundled in this very package (${CLAUDE_PLUGIN_ROOT}/dist/main.js)
#   2. the project's own devDependency, so a pinned version wins
#   3. PATH
#   4. npx, which resolves the registry's `latest` and needs the network
PLUGIN_MAIN="${CLAUDE_PLUGIN_ROOT:-${SCRIPT_ROOT:-}}"
[ -z "$PLUGIN_MAIN" ] && PLUGIN_MAIN="$(cd "$(dirname "$0")/.." && pwd)"

if [ -f "${PLUGIN_MAIN}/dist/main.js" ] && command -v node >/dev/null 2>&1; then
    SPECDX="node ${PLUGIN_MAIN}/dist/main.js"
elif [ -x "${PROJECT_ROOT}/node_modules/.bin/specdx" ]; then
    SPECDX="${PROJECT_ROOT}/node_modules/.bin/specdx"
elif command -v specdx >/dev/null 2>&1; then
    SPECDX="specdx"
elif command -v npx >/dev/null 2>&1; then
    SPECDX="npx --yes specdx"
else
    # No way to run specdx — exit silently
    exit 0
fi

# Run validate and graph from the project root; capture output gracefully.
# Filter npm warn lines (noise from pnpm workspace roots when using npx).
run_specdx() {
    (cd "$1" && $SPECDX "${@:2}" 2>&1) | grep -v '^npm warn' || true
}

# Keep the injected block bounded. `graph` grows with the suite -- one line per
# spec, plus one per reference edge, plus the "not reflected in config requires"
# advice -- so a large suite would silently spend a large part of the context
# window on a session summary. The cap is stated in lines rather than tokens
# because that is what this script can count.
MAX_GRAPH_LINES=40

truncate_lines() {
    awk -v max="$1" '
        NR <= max { print }
        END { if (NR > max) printf "  … %d more line(s) — run `specdx graph` for the rest\n", NR - max }
    '
}

validate_out="$(run_specdx "$PROJECT_ROOT" validate)" || validate_out="(validate failed)"
graph_out="$(run_specdx "$PROJECT_ROOT" graph | truncate_lines "$MAX_GRAPH_LINES")" ||
    graph_out="(graph failed)"

# Build a compact summary (target: under 500 tokens)
summary="<specdx-context>
Project root: ${PROJECT_ROOT}

Validation:
${validate_out}

Dependency graph:
${graph_out}
</specdx-context>"

session_context="$(escape_for_json "$summary")"

# Output context injection as JSON.
# Claude Code hooks expect hookSpecificOutput.additionalContext.
# Cursor hooks expect additional_context.
# Emit only the field consumed by the current platform.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
    printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
fi

exit 0
