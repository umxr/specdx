{
  "name": "specdx",
  "version": "0.4.0-alpha.4",
  "description": "Spec-driven development toolchain. Validate, lint, pack, and ship specs for LLM-assisted workflows.",
  "type": "module",
  "license": "MIT",
  "author": "Umar Gora (https://github.com/umxr)",
  "repository": {
    "type": "git",
    "url": "https://github.com/umxr/specdx.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/umxr/specdx#readme",
  "bugs": {
    "url": "https://github.com/umxr/specdx/issues"
  },
  "keywords": [
    "spec",
    "specification",
    "prd",
    "technical-design",
    "api-contract",
    "lint",
    "validation",
    "llm",
    "ai",
    "context-packing",
    "spec-driven-development",
    "claude-code"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "specdx": "./dist/main.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    ".claude-plugin",
    "hooks"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "citty": "^0.2.1",
    "consola": "^3.4.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.18",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.12",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@specdx/check": "workspace:*",
    "@specdx/core": "workspace:*",
    "@specdx/diff": "workspace:*",
    "@specdx/lint": "workspace:*",
    "@specdx/mcp": "workspace:*",
    "@specdx/pack": "workspace:*",
    "@specdx/schema": "workspace:*",
    "@specdx/skills": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
